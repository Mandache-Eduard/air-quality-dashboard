{
  "name": "Timisoara Air Quality Dashboard",
  "background": "#101014",
  "foreground": "#FBFAF5",
  "tableAccent": "#3D6AD2",
  "textClasses": {
    "callout": {
      "fontFace": "Montserrat",
      "fontSize": 40,
      "color": "#FBFAF5"
    },
    "title": {
      "fontFace": "Montserrat",
      "fontSize": 13,
      "color": "#FBFAF5"
    },
    "header": {
      "fontFace": "Montserrat",
      "fontSize": 12,
      "color": "#FBFAF5"
    },
    "label": {
      "fontFace": "Montserrat",
      "fontSize": 10,
      "color": "#FBFAF5"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#101014"
              }
